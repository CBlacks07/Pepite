# Copie ce fichier en .env.local (jamais commité) et remplis les valeurs.
# `neon deploy` remplit automatiquement les variables Neon dans .env.local.

# Connexion Neon "poolée" : utilisée par l'API (routes +api.ts).
DATABASE_URL=
# Connexion directe : utilisée par les migrations (npm run db:migrate).
DATABASE_URL_UNPOOLED=

# Mode test de la connexion : le code à 6 chiffres s'affiche à l'écran au lieu
# d'être envoyé par SMS. À mettre à 1 en local uniquement, JAMAIS en production.
OTP_DEV_MODE=
